{
  "nodes": {
    "sidebar-lists": {
      "active": "inbox"
    }
  },
  "theme": {
    "light": "paper",
    "dark": "graphite"
  },
  "file": {
    "id": "root",
    "cloned_from": {
      "name": "herdr-t3",
      "version": "0.1.12"
    },
    "type": "row",
    "children": [
      {
        "id": "sidebar",
        "type": "column",
        "children": [
          {
            "id": "brand",
            "type": "block",
            "content": {
              "mod": "dz-chrome"
            },
            "size": {
              "px": 40.0
            },
            "window_drag": true
          },
          {
            "id": "sidebar-lists",
            "type": "stack",
            "children": [
              {
                "id": "lists",
                "type": "column",
                "children": [
                  {
                    "id": "spaces",
                    "type": "block",
                    "content": {
                      "mod": "dz-spaces"
                    },
                    "size": {
                      "weight": 1.0
                    },
                    "min": 90.0
                  },
                  {
                    "id": "agents",
                    "type": "block",
                    "content": {
                      "mod": "dz-agents"
                    },
                    "size": {
                      "weight": 1.0
                    },
                    "min": 90.0
                  }
                ]
              },
              {
                "id": "inbox",
                "type": "block",
                "content": {
                  "mod": "dz-inbox",
                  "props": {
                    "newMenu": "dz-launch"
                  }
                }
              }
            ],
            "active": "lists"
          },
          {
            "id": "sidebar-footer",
            "type": "block",
            "content": {
              "mod": "dz-chrome",
              "props": {
                "footer": true,
                "projects": true
              }
            },
            "size": {
              "px": 72.0
            }
          }
        ],
        "size": {
          "px": 256.0
        },
        "min": 208.0,
        "max": 480.0,
        "background": "chrome",
        "resizable": false
      },
      {
        "id": "work",
        "type": "column",
        "children": [
          {
            "id": "tabs",
            "type": "block",
            "content": {
              "mod": "dz-tabs",
              "props": {
                "closeWith": "dz-close"
              }
            },
            "size": {
              "px": 40.0
            },
            "window_drag": true
          },
          {
            "id": "work-body",
            "type": "row",
            "children": [
              {
                "id": "main",
                "type": "block",
                "content": {
                  "tab": "active",
                  "pane": {
                    "header": {
                      "content": {
                        "mod": "dz-pane"
                      },
                      "reveal": "always",
                      "height": 28.0,
                      "position": "top"
                    },
                    "background": "background",
                    "border": {
                      "width": 2.0,
                      "color": "background"
                    },
                    "focus": {
                      "width": 2.0,
                      "color": "background"
                    },
                    "radius": 8.0,
                    "gap": 8.0,
                    "lone": true
                  }
                }
              }
            ],
            "padding": [
              2.0,
              8.0
            ],
            "gap": 8.0
          },
          {
            "id": "work-bottom-inset",
            "type": "row",
            "children": [],
            "size": {
              "px": 6.0
            }
          },
          {
            "id": "status",
            "type": "block",
            "content": {
              "mod": "workspace-status"
            },
            "size": {
              "px": 28.0
            },
            "hidden": true
          }
        ],
        "resizable": false
      }
    ],
    "background": "canvas",
    "terminal_padding": [
      8.0,
      0.0
    ],
    "terminal_opacity": 0.0,
    "divider": {
      "width": 1.0,
      "color": "border"
    },
    "titlebar": "none",
    "traffic_lights": [
      16.0,
      13.0
    ],
    "preview": "layouts/dz-projects.svg"
  }
}
