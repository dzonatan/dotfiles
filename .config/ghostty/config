theme = gruvbox
font-size = 16
macos-option-as-alt = true

split-divider-color = #d5c4a1
unfocused-split-opacity = 0.5

window-padding-x = 10,20

# tmux like keymaps
keybind = ctrl+z=toggle_split_zoom
#keybind = shift+enter=text:\n
keybind = cmd+ctrl+l=goto_split:right
keybind = cmd+ctrl+h=goto_split:left
keybind = cmd+ctrl+j=goto_split:bottom
keybind = cmd+ctrl+k=goto_split:top

# scroll up/down
keybind = page_up=scroll_page_lines:-5
keybind = page_down=scroll_page_lines:5
keybind = home=scroll_to_top
keybind = end=scroll_to_bottom

# let cmd+1..9 through to herdr (switch_workspace)
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
